# LLM provider - gemini or litellm
CHESS_LLM_PROVIDER=gemini
CHESS_LLM_MODEL=gemini-2.5-flash

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# LiteLLM/OpenAI-compatible provider
OPENAI_API_KEY=your-openai-compatible-key
OPENAI_API_BASE=https://your-litellm-proxy.example.com/v1

# Stockfish path for Postgame Analyst
# Windows example: C:\Tools\stockfish\stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=
CHESS_STOCKFISH_TIME_LIMIT=0.25
